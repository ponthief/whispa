<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- App Lock unlock prompt (react-native-keychain biometric / device
         credential). USE_FINGERPRINT covers API 23–27; USE_BIOMETRIC is API 28+. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
    <!-- Push notifications (Android 13+ needs runtime consent). The FCM service
         itself is merged in from @react-native-firebase/messaging. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- QR scanning (recipient address). Camera is optional so the app still
         installs on devices without one. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Settings -> About -> "Check for updates" downloads the release APK and
         hands it to Android's installer. There is no app store here: updates
         are GitHub releases, and without this the only route is a browser
         download the user then has to find and tap.

         The permission does not let this app install anything by itself. It
         lets it ASK, and API 26+ requires the user to grant it per-app in
         Settings first (updater/ApkInstallerModule.kt sends them there). What
         then arrives is Android's own installer dialog, which refuses the
         update outright unless the APK is signed with the same certificate as
         the installed copy — so this cannot be used to replace WhiSPa with
         something else. See ApkInstallerModule.kt for the full chain. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme">
      <!-- SplashTheme, not AppTheme: this is the window Android draws from the
           tap on the launcher until React Native has a frame, and AppTheme's
           background is AppCompat's default — white under a light system
           theme. MainActivity swaps to AppTheme in onCreate; see the note
           there for why that line is not optional. -->
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:theme="@style/SplashTheme"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>

        <!-- App Link for the registration verification URL, so the link in the
             email opens the app instead of a browser. The app redeems the token
             itself (hooks/useVerifyLink) and can then sign the user straight in
             rather than sending them back to a login form.

             autoVerify makes Android check https://<host>/.well-known/assetlinks.json
             at install time for this package name and signing certificate. Until
             that file is served, verification simply fails and the link keeps
             opening in the browser — which still works, since the web /verify
             page redeems the token exactly as before. Nothing breaks while the
             domain side is outstanding.

             The host is a per-flavor placeholder (app/build.gradle): mainnet and
             signet are separate applicationIds, so they need separate hosts, or
             both would claim the same URL and Android would ask the user which
             app to open.

             singleTask above is what makes a link arriving while the app is
             already running reach JS: ReactActivity forwards onNewIntent to the
             Linking module, so no native code is needed for it. -->
        <intent-filter android:autoVerify="true">
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data
                android:scheme="https"
                android:host="${verifyHost}"
                android:pathPrefix="/verify" />
        </intent-filter>
      </activity>

      <!-- The QR scanner (scanner/WhispaCaptureActivity.kt).

           Declared here because it is ours. zxing-android-embedded declares
           its own CaptureActivity as sensorLandscape, which turns a phone
           held upright into a sideways preview with a letterbox framing rect.
           fullSensor follows how the phone is actually held; CaptureManager
           still locks to whatever that was at launch, so the preview does not
           flip mid-scan.

           The rest mirrors the library's own declaration: the scanner holds
           no state worth restoring, and a soft keyboard over a camera preview
           is never wanted. -->
      <activity
        android:name=".scanner.WhispaCaptureActivity"
        android:clearTaskOnLaunch="true"
        android:screenOrientation="fullSensor"
        android:stateNotNeeded="true"
        android:theme="@style/zxing_CaptureTheme"
        android:windowSoftInputMode="stateAlwaysHidden"
        android:exported="false" />

      <!-- What a push notification looks like.
           Without this, FCM falls back to the launcher icon: the small icon is
           masked to a white silhouette of a full-colour icon, which is the
           featureless blob a notification showed before. The icon is
           res/drawable/ic_notification.xml, the same ₿ as the balance on the
           Wallet tab.

           The matching default_notification_color is NOT set here.
           @react-native-firebase/messaging declares that meta-data itself,
           from a manifest placeholder, so a second declaration here fails the
           manifest merger outright. Its value comes from firebase.json in the
           repo root, which is the library's own knob for it. -->
      <meta-data
        android:name="com.google.firebase.messaging.default_notification_icon"
        android:resource="@drawable/ic_notification" />

      <!-- Builds the payment notification itself, so it can carry the logo:
           FCM has no field for a large icon, and the small icon is an alpha
           mask that would flatten the mark to a blob. The server sends payment
           pushes as data-only messages so nothing in the firebase SDK displays
           them first. See notify/PaymentNotificationReceiver.kt.

           A receiver rather than a FirebaseMessagingService on purpose: a
           second service would displace the one @react-native-firebase brings,
           cutting JS off from messages. FCM broadcasts to every matching
           receiver in the package, so this one runs beside the library's.

           exported=true is required — the sender is Google Play services, not
           this app — and the c2dm SEND permission is what keeps anything else
           from broadcasting to it. -->
      <receiver
        android:name=".notify.PaymentNotificationReceiver"
        android:exported="true"
        android:permission="com.google.android.c2dm.permission.SEND">
        <intent-filter>
          <action android:name="com.google.android.c2dm.intent.RECEIVE" />
        </intent-filter>
      </receiver>

      <!-- Serves the downloaded APK to Android's installer. From API 24 a
           file:// URI handed to another app throws, so the installer is given a
           content:// one instead, granted read access for that one Intent.

           The authority is ${applicationId}, not the namespace: the signet
           flavour adds applicationIdSuffix ".signet" so the two builds install
           side by side, and two providers claiming one authority makes the
           second install fail with a duplicate-authority error.
           ApkInstallerModule builds the same string from getPackageName(),
           which returns the applicationId, so the two always agree.

           exported=false: nothing outside this app may ask for these files. -->
      <provider
        android:name="androidx.core.content.FileProvider"
        android:authorities="${applicationId}.updates"
        android:exported="false"
        android:grantUriPermissions="true">
        <meta-data
          android:name="android.support.FILE_PROVIDER_PATHS"
          android:resource="@xml/apk_file_paths" />
      </provider>
    </application>
</manifest>
