{
  "name": "thrilla",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android --mode=mainnetDebug",
    "android:signet": "react-native run-android --mode=signetDebug",
    "apk:mainnet": "cd android && ./gradlew assembleMainnetRelease",
    "apk:signet": "cd android && ./gradlew assembleSignetRelease",
    "apk:mainnet:lowmem": "cd android && ./gradlew assembleMainnetRelease -PreactNativeArchitectures=arm64-v8a --no-daemon",
    "apk:signet:lowmem": "cd android && ./gradlew assembleSignetRelease -PreactNativeArchitectures=arm64-v8a --no-daemon",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "lint": "eslint . --ext .ts,.tsx",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:mainnet": "vite build --mode mainnet",
    "preview:mainnet": "vite preview --mode mainnet",
    "build:signet": "vite build --mode signet",
    "preview:signet": "vite preview --mode signet",
    "build:regtest": "vite build --mode regtest",
    "preview:regtest": "vite preview --mode regtest",
    "build:admin": "vite build --mode admin",
    "build:admin-signet": "vite build --mode admin-signet",
    "build:admin-regtest": "vite build --mode admin-regtest",
    "preview:admin-regtest": "vite preview --mode admin-regtest",
    "check:signing": "npm run check:signing:sp && npm run check:signing:plain && npm run check:signing:payjoin && npm run check:signing:tango && npm run check:signing:commit && npm run check:signing:coins && npm run check:signing:display && npm run check:signing:chains && npm run check:signing:change",
    "check:signing:sp": "node --experimental-strip-types scripts/check-sp-signing.mjs",
    "check:signing:plain": "node --experimental-strip-types scripts/check-plain-signing.mjs",
    "check:update": "node --experimental-strip-types scripts/check-update-flow.mjs",
    "check:signing:payjoin": "node scripts/check-payjoin-signing.mjs",
    "check:signing:tango": "node scripts/check-tango-signing.mjs",
    "check:signing:commit": "node scripts/check-tango-commit.mjs",
    "check:signing:coins": "node scripts/check-tango-coins.cjs",
    "check:signing:display": "node --experimental-strip-types scripts/check-tango-display.mjs",
    "check:signing:chains": "node --experimental-strip-types scripts/check-chain-guard.mjs",
    "check:signing:change": "node --experimental-strip-types scripts/check-tango-change.mjs",
    "check:contacts": "node scripts/check-contact-staleness.cjs",
    "check:payout": "node scripts/check-tango-payout.cjs",
    "check:slider": "node scripts/check-send-slider.mjs",
    "check:plain": "node scripts/check-plain-receive.mjs",
    "check:vue": "node scripts/check-vue-imports.cjs",
    "check:admin": "node scripts/check-admin-payouts.cjs",
    "check:lock": "node scripts/check-app-lock.cjs"
  },
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "^6.0.0",
    "@capacitor/core": "^6.2.0",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@react-native-firebase/app": "^20.5.0",
    "@react-native-firebase/messaging": "^20.5.0",
    "@react-native-clipboard/clipboard": "^1.14.1",
    "@scure/base": "^1.2.6",
    "@scure/bip32": "^1.7.0",
    "@scure/bip39": "^1.6.0",
    "pinia": "^2.1.7",
    "qrcode": "^1.5.3",
    "qrcode-generator": "^1.4.4",
    "react": "18.2.0",
    "react-native": "0.73.6",
    "react-native-camera-kit": "^13.0.0",
    "react-native-config": "^1.5.5",
    "react-native-get-random-values": "^1.11.0",
    "react-native-keychain": "^8.2.0",
    "react-native-safe-area-context": "^4.8.2",
    "react-native-svg": "^14.1.0",
    "text-encoding-polyfill": "^0.6.7",
    "unorm": "^1.6.0",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native/babel-preset": "0.73.21",
    "@react-native/eslint-config": "0.73.2",
    "@react-native/metro-config": "0.73.5",
    "@tsconfig/react-native": "3.0.0",
    "@types/jest": "^29.5.0",
    "@types/react": "18.2.6",
    "@vitejs/plugin-vue": "^5.0.4",
    "babel-jest": "^29.6.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "8.48.0",
    "jest": "^29.6.0",
    "prettier": "2.8.8",
    "typescript": "5.1.6",
    "vite": "^5.2.0"
  },
  "engines": {
    "node": ">=18"
  }
}
