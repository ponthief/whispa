<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ic_launcher_background">#070404</color>
    <!-- Tints the notification's small icon and app name; wired up in
         firebase.json, not the manifest, because the messaging library
         declares that meta-data itself. Same value as
         colors.primary in src/theme.ts; there is no way to share one literal
         across a React Native theme and an Android resource, so if one moves
         the other has to move with it. -->
    <color name="notification_accent">#F97316</color>
    <!-- The launch window's background, behind the mark, until React Native
         has a frame to show. Same value as colors.bg in src/theme.ts and so
         the same literal in two places for the same reason as the accent
         above: a React Native theme and an Android resource cannot share one.
         If this and SplashGate's background drift, the handover from the
         system splash to the app's own stops being invisible and becomes a
         flicker nobody can account for. -->
    <color name="splash_background">#080B0F</color>
</resources>
